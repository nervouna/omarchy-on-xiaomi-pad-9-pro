+// AQ_DRM_CONNECTOR_PROPS="name=value[,name=value...]": extra connector
+// properties set on every enabling modeset. Qualcomm SDE needs "dsc_mode=1" so
+// the first commit after continuous splash keeps the DSC config (otherwise the
+// DSI driver sees a DSC mode switch on the first frame and never enables the
+// panel: no backlight control, DPMS crashes).
+void Aquamarine::CDRMAtomicRequest::addExtraConnectorProps(Hyprutils::Memory::CSharedPointer<SDRMConnector> connector) {
+    const char* env = getenv("AQ_DRM_CONNECTOR_PROPS");
+    if (!env || !*env)
+        return;
+    auto props = drmModeObjectGetProperties(backend->gpu->fd, connector->id, DRM_MODE_OBJECT_CONNECTOR);
+    if (!props)
+        return;
+    std::string_view list{env};
+    while (!list.empty()) {
+        const auto comma = list.find(',');
+        const auto item  = list.substr(0, comma);
+        list             = comma == std::string_view::npos ? std::string_view{} : list.substr(comma + 1);
+        const auto eq    = item.find('=');
+        if (eq == std::string_view::npos)
+            continue;
+        const std::string name{item.substr(0, eq)};
+        const uint64_t    value = std::strtoull(std::string{item.substr(eq + 1)}.c_str(), nullptr, 0);
+        for (uint32_t i = 0; i < props->count_props; ++i) {
+            auto prop = drmModeGetProperty(backend->gpu->fd, props->props[i]);
+            if (!prop)
+                continue;
+            if (name == prop->name)
+                add(connector->id, prop->prop_id, value);
+            drmModeFreeProperty(prop);
+        }
+    }
+    drmModeFreeObjectProperties(props);
+}
