+// AQ_DRM_DMA_HEAP=/dev/dma_heap/<heap>: allocate KMS scanout buffers from a DMA-BUF
+// heap instead of GBM (Android GKI: KGSL GPU is not a DRM device, GBM on the display
+// node cannot allocate display-importable buffers for the GPU renderer).
+static SP<IAllocator> scanoutAllocator(SP<CBackend> backend) {
+    static SP<IAllocator> heap;
+    static bool           tried = false;
+    if (!tried) {
+        tried = true;
+        if (const auto ENV = getenv("AQ_DRM_DMA_HEAP"); ENV && *ENV)
+            heap = CDMAHeapAllocator::create(backend, ENV);
+    }
+    return heap ? heap : backend->primaryAllocator;
+}
