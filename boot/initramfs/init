#!/bin/sh
# LoA stage-1 init for Omarchy on Xiaomi Pad 9 Pro (shuntian).
# Runs as PID 1 from init_boot_b on the stock Android kernel (merged over the
# stock vendor ramdisk, which provides /lib/modules). Mounts the ext4 root on
# the `omarchy` partition (carved from userdata, 2026-09-27), falling back to
# the old root on `ramdump`, and hands PID 1 to systemd.
#
# Safety: a boot-attempt counter on the root filesystem sends the tablet to
# Fastboot after 3 consecutive boots that never reached loa-boot-ok, and an
# optional dev watchdog (/loa/dev-watchdog containing seconds) reboots to
# Fastboot unless /run/loa-boot-ok appears in time.
export PATH=/bin
ROOT_PARTS="omarchy ramdump"   # first one that exists and mounts wins
MAX_ATTEMPTS=3

log() { echo "<3>loa-init: $*" > /dev/kmsg; }
# Hand PID 1 to the untouched stock Android first-stage init (shipped in this
# ramdisk as /init.android). Undo everything we mounted so Android starts clean;
# already-loaded modules are fine (its modprobe treats them as loaded).
boot_android() {
    log "booting stock Android: $*"
    echo > /proc/sys/kernel/hotplug 2>/dev/null
    for m in /sys/kernel/debug /dev/pts /dev /run /config /sys /proc; do umount "$m" 2>/dev/null; done
    mv /init.android /init
    exec /init
}
to_fastboot() { log "rebooting to bootloader: $*"; sync; /loa/loa-helper bootloader; sleep 5; echo b > /proc/sysrq-trigger; }

mkdir -p /proc /sys /dev /run /config /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755 tmpfs /dev
mknod -m 600 /dev/kmsg c 1 11
mknod -m 666 /dev/null c 1 3
echo on > /proc/sys/kernel/printk_devkmsg
mkdir -p /dev/pts /dev/shm
mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts /dev/pts
ln -s pts/ptmx /dev/ptmx
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t configfs configfs /config
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
log "stage 1 start, kernel $(uname -r)"

# Stage-1 modules (proven set from the V9-V13 RAM probes: stock first-stage
# list plus the USB/interconnect dependencies they needed).
ok=0; bad=0
while read -r m; do
    [ -n "$m" ] || continue
    if insmod "$m" 2>/dev/null; then ok=$((ok+1)); else
        grep -q "^$(basename "$m" .ko | tr - _) " /proc/modules && ok=$((ok+1)) || { bad=$((bad+1)); log "insmod failed: $m"; }
    fi
done < /loa/stage1-modules.txt
log "stage-1 modules ok=$ok failed=$bad"

# A panic must reboot (-> boot counter -> Fastboot), never park the tablet in
# Qualcomm CrashDump/download mode, which needs physical button presses.
echo 0 > /sys/module/qcom_dload_mode/parameters/download_mode 2>/dev/null
echo -1 > /proc/sys/kernel/panic
log "download_mode=$(cat /sys/module/qcom_dload_mode/parameters/download_mode 2>/dev/null) panic=$(cat /proc/sys/kernel/panic)"

# Populate /dev (the GKI kernel has no devtmpfs) and find the root partition.
echo /bin/mdev > /proc/sys/kernel/hotplug 2>/dev/null
mdev -s
# Boot menu: hold Volume Up (after releasing Power) during the boot logo -> Android.
# Volume Down + Power is still the bootloader's own Fastboot combo.
/loa/loa-helper keys 2000 && boot_android "Volume Up held"
part_dev() {
    for u in /sys/class/block/*/uevent; do
        grep -q "^PARTNAME=$1\$" "$u" && { echo /dev/$(sed -n 's/^DEVNAME=//p' "$u"); return; }
    done
}
# Wait for the UFS partitions (the last candidate is the one that always exists).
last=${ROOT_PARTS##* }
for i in $(seq 1 100); do
    mdev -s
    d=$(part_dev $last); [ -n "$d" ] && [ -b "$d" ] && break
    sleep 0.1
done
dev=""
for p in $ROOT_PARTS; do
    d=$(part_dev $p)
    [ -n "$d" ] && [ -b "$d" ] || { log "root partition $p not found"; continue; }
    if mount -t ext4 -o rw,noatime "$d" /newroot; then
        dev=$d; log "root partition $p = $d"; break
    fi
    log "root partition $p = $d: mount failed"
done
[ -n "$dev" ] || { /loa/rescue.sh "no root partition mounted"; to_fastboot "root mount failed"; }

# One-shot "reboot to Android" request from Omarchy (loa-reboot-android).
if [ -e /newroot/loa/next-boot-android ]; then
    rm -f /newroot/loa/next-boot-android; sync; umount /newroot
    boot_android "next-boot-android flag"
fi

# Boot-attempt counter: cleared by loa-boot-ok.service in the booted system.
mkdir -p /newroot/loa
n=$(cat /newroot/loa/boot-attempts 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0;; esac
if [ -e /newroot/loa/force-rescue ] || [ "$n" -ge "$MAX_ATTEMPTS" ]; then
    echo 0 > /newroot/loa/boot-attempts
    rm -f /newroot/loa/force-rescue
    sync; umount /newroot
    /loa/rescue.sh "boot attempts=$n"
    to_fastboot "$n failed boot attempts"
fi
echo $((n+1)) > /newroot/loa/boot-attempts; sync

# Optional dev watchdog, survives switch_root as an orphan process.
if [ -s /newroot/loa/dev-watchdog ]; then
    secs=$(cat /newroot/loa/dev-watchdog); case "$secs" in ''|*[!0-9]*) secs=600;; esac
    log "dev watchdog armed: ${secs}s"
    /loa/loa-helper watchdog "$secs"
fi

# First boot of a from-scratch image: the first-stage (ramdisk) modules exist only
# here, in the stock vendor ramdisk. The rest is imported by loa-vendor-import.
K=$(uname -r)
if [ ! -d /newroot/usr/lib/modules/$K/ramdisk ] && [ -d /lib/modules ]; then
    mkdir -p /newroot/usr/lib/modules/$K/ramdisk /newroot/usr/lib/loa/modules
    cp /lib/modules/*.ko /newroot/usr/lib/modules/$K/ramdisk/
    cp /lib/modules/modules.load /newroot/usr/lib/loa/modules/first_stage.load 2>/dev/null
    rm -f /newroot/usr/lib/loa/vendor-imported   # re-run depmod over the full set
    sync; log "imported $(ls /newroot/usr/lib/modules/$K/ramdisk | wc -l) ramdisk modules"
fi

echo /usr/lib/firmware/image > /sys/module/firmware_class/parameters/path 2>/dev/null
echo > /proc/sys/kernel/hotplug  # stage-2 runs mdev as a netlink daemon
# systemd (PID 1) subscribes to udev events only if /run/udev/control exists or
# /dev is a devtmpfs when it starts; otherwise it assumes a container and never
# sees device events (device units stay "tentative", jobs waiting on devices
# hang: zram, serial-getty@ttyGS0). The GKI kernel has no devtmpfs, so leave a
# placeholder with the paths systemd-udevd-varlink.socket uses; that socket unit
# unlinks the stale file when it binds and keeps the identical control symlink.
mkdir -p /run/udev
: > /run/udev/io.systemd.Udev
ln -sf /run/udev/io.systemd.Udev /run/udev/control
echo "$dev" > /run/loa-root-dev
cp /bin/busybox /run/loa-busybox 2>/dev/null

[ -x /newroot/usr/lib/systemd/systemd ] || { /loa/rescue.sh "no systemd"; to_fastboot "no systemd in root"; }
for d in dev proc sys run config; do mkdir -p /newroot/$d; mount --move /$d /newroot/$d; done
log "switching root to systemd"
exec switch_root /newroot /usr/lib/systemd/systemd --log-target=kmsg
