[Unit]
Description=LoA zram swap (half of RAM, zstd)
DefaultDependencies=no
# Not after local-fs.target: tmp.mount is ordered after swap.target, so that
# formed a cycle and systemd dropped this job (no zram on some boots).
# The root fs is mounted by stage 1; /dev/zram0 is created by mdev.
After=loa-mdev.service loa-vendor-import.service
Before=swap.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/loa/zram-setup.sh
ExecStop=/usr/bin/swapoff /dev/zram0

[Install]
WantedBy=swap.target
