[Unit]
Description=LoA boot reached the desktop: clear stage-1 boot-attempt counter
After=loa-desktop.service multi-user.target
Requires=loa-desktop.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/sleep 20
ExecStartPre=/usr/bin/systemctl is-active --quiet loa-desktop.service
# Also moves loa-update's boot marker from "tried" (set by
# loa-update-rollback.service) to "booted": the update stays on trial until
# loa-update-confirm.service. Never touches a marker not yet tried.
ExecStart=/usr/bin/sh -c 'echo 0 > /loa/boot-attempts; grep -qx tried /var/lib/loa-update/pending 2>/dev/null && echo booted > /var/lib/loa-update/pending; touch /run/loa-boot-ok; sync'
[Install]
WantedBy=graphical.target
