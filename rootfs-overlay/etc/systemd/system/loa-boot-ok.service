[Unit]
Description=LoA boot reached the desktop: clear stage-1 boot-attempt counter
After=loa-desktop.service multi-user.target
Requires=loa-desktop.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/sleep 20
ExecStartPre=/usr/bin/systemctl is-active --quiet loa-desktop.service
# Also clears loa-update's boot marker once a boot after an update got here
# ("tried", set by loa-update-rollback.service), never one not yet tried.
ExecStart=/usr/bin/sh -c 'echo 0 > /loa/boot-attempts; grep -qx tried /var/lib/loa-update/pending 2>/dev/null && rm -f /var/lib/loa-update/pending; touch /run/loa-boot-ok; sync'
[Install]
WantedBy=graphical.target
