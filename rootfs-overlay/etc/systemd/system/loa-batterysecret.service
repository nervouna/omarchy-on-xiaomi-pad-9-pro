[Unit]
Description=Stock Xiaomi batterysecret (battery + charger authentication)
# Without it the MCA charger keeps a "batt_auth" cap on the charge current
# (2 A) and never authenticates Xiaomi PD chargers (no fast charge).
# Android starts it on sys.boot_completed.
After=loa-android.service
Requires=loa-android.service
[Service]
# As vendor init.batterysecret.rc: tell the MCA charger driver the product/region.
ExecStartPre=/bin/sh -c 'P=/sys/class/xm_power/charger/charger_common/property; echo ro.product.name=shuntian > $P; echo persist.vendor.region.charger=default > $P'
ExecStart=/usr/lib/loa/android-run /vendor/bin/batterysecret
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
