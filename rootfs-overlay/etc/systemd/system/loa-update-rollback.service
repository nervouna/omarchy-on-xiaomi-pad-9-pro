[Unit]
Description=LoA: boot check of an over-the-air update (roll back a failed one)
# Runs `loa-update boot-check` on the marker /var/lib/loa-update/pending (states
# in /usr/local/bin/loa-update): "applied" from an earlier boot turns into
# "tried"; "applying", "tried" or "booted" means the install, a rollback or the
# last boot of the update failed: roll back (and daemon-reload); an empty or
# unknown marker is rolled back if an update is recorded. Before the early LoA
# units and udev, so an update that breaks early boot is caught too; ordering
# only, so a failed rollback never holds up the boot. No After=: local-fs.target
# would close a cycle (tmp.mount -> swap.target -> loa-zram -> loa-mdev), and
# the root is mounted read-write by stage 1.
# ExecStart runs the copy of loa-update kept with the update's record (the one
# that wrote it), else the installed one. Never change that line in a release:
# the old unit runs on the first boot after an update that changes it.
DefaultDependencies=no
Before=loa-mdev.service loa-vendor-import.service loa-modules.service loa-zram.service systemd-udevd.service sysinit.target loa-desktop.service loa-boot-ok.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/var/lib/loa-update/pending
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'r=$$(cat /var/lib/loa-update/last 2>/dev/null); [ -x "$$r/loa-update" ] && exec "$$r/loa-update" boot-check; exec /usr/local/bin/loa-update boot-check'
[Install]
WantedBy=sysinit.target
