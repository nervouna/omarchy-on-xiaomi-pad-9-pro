[Unit]
Description=LoA: roll back and reboot a boot of an update that has no desktop after 300 s
# `loa-update boot-deadline` acts only when the marker is "tried" (set by this
# boot's boot check) and /run/loa-boot-ok does not exist: it rolls back, resets
# the stage-1 boot counter and reboots. Any other marker, or a boot that reached
# loa-boot-ok, leaves everything as it is.
DefaultDependencies=no
After=loa-update-rollback.service
Before=shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/var/lib/loa-update/pending
[Service]
Type=simple
ExecStart=/bin/sh -c 'sleep 300; exec /usr/local/bin/loa-update boot-deadline'
[Install]
WantedBy=sysinit.target
