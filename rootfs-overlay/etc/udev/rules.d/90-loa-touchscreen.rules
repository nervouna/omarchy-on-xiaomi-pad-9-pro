# shuntian NT36536 (Xiaomi THP) touchscreen: raw X spans the panel's short side
# (top = max), raw Y the long side (left = 0). Map onto the landscape 3200x2136
# DSI panel: x' = y, y' = 1 - x. Measured with corner taps on 2026-09-25.
ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="NVTCapacitiveTouchScreen", ENV{LIBINPUT_CALIBRATION_MATRIX}="0 1 0 -1 0 1"
