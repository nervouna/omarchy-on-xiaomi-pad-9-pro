From 764422da41b896b5c2fd24b8b7d098d7bcd8ebc5 Mon Sep 17 00:00:00 2001
From: Xiaoyu Guan <xiaoyuguan@hotmail.com>
Date: Mon, 28 Sep 2026 22:57:35 +0800
Subject: [PATCH 4/4] audio: enable the output slider whenever an output exists

The slider was bound to root.sink, which stays null on this device's
PipeWire setup while an output is present; use root.hasOutput.
---
 shell/plugins/panels/audio/Panel.qml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/shell/plugins/panels/audio/Panel.qml b/shell/plugins/panels/audio/Panel.qml
index 990dd1fa..e56fd849 100644
--- a/shell/plugins/panels/audio/Panel.qml
+++ b/shell/plugins/panels/audio/Panel.qml
@@ -899,7 +899,7 @@ Panel {
                 step: 0.05
                 value: root.outputVolume
                 opacity: root.outputMuted ? 0.5 : 1.0
-                enabled: !!root.sink
+                enabled: root.hasOutput
 
                 onMoved: function(v) { root.setOutputVolume(v) }
                 onRightClicked: root.toggleOutputMute()
